<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <meta name="author" content="Bassem Krayem">
    <meta name="google-site-verification" content="3o8WmRnXkiWKeXYUb56umZO6Me4Ub0fL58rmVt_0qFg" />
    <link rel="canonical" href="<%= canonical %>">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <!-- Link previews (LinkedIn, WhatsApp, Telegram, X) -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Bassem Krayem">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= canonical %>">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header>
        <nav aria-label="Global Navigation">
            <ul>
                <li>
                    <a href="/" <%- path==='home' ? 'aria-current="page"' : '' %>>Home</a>
                </li>
                <li>
                    <a href="/about" <%- path==='about' ? 'aria-current="page"' : '' %>>About</a>
                </li>
                <li>
                    <a href="/portfolio" <%- path==='portfolio' ? 'aria-current="page"' : '' %>>Portfolio</a>
                </li>
                <li>
                    <a href="/resume">Resume</a>
                </li>
                <li>
                    <a href="/contact" <%- path==='contact' ? 'aria-current="page"' : '' %>>Contact</a>
                </li>
            </ul>
        </nav>
    </header>
    <hr>
